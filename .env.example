# Cosmo robot — environment template (AB-026).
# Copy to .env and fill in. NEVER commit real values; .env is gitignored.
# Real values live in the secrets system — see ~/secrets/INDEX.md (`secret list`).

# Anthropic API — Cosmo's language brain (cognition/llm.py)
ANTHROPIC_API_KEY=

# Picovoice — wake-word engine license (perception/audio/wake_word.py)
PICOVOICE_KEY=

# WhatsApp id (JID) that receives Cosmo's outbound notifications
ADMIN_WA_ID=

# Tuya local key for the Wipro smart bulb at 192.168.1.3 (hardware/wipro_light.py)
# Re-obtain via tinytuya wizard if the bulb is factory-reset.
WIPRO_LOCAL_KEY=

# Bearer token guarding the robot HTTP API on :8000 (motor/mind/sound/trigger
# endpoints; /cosmo/say stays open for banteragent compatibility)
ROBOT_API_TOKEN=
